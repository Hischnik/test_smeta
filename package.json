{
  "name": "metrazh",
  "version": "1.0.0",
  "private": true,
  "description": "Метраж — веб-приложение для составления и просмотра смет на ремонт квартир",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-reporter=spec tests/",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pdfkit": "^0.20.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/manrope": "^5.2.8",
    "@napi-rs/canvas": "^1.1.0",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.65.0"
  }
}
