# Скопируйте файл в .env и измените значения перед запуском.
# Кодировка — UTF-8.

# Сеть
PORT=3000
HOST=127.0.0.1
# За обратным прокси (HTTPS) обычно: HOST=127.0.0.1, TRUST_PROXY=1
PUBLIC_BASE_URL=

# Данные
DATA_DIR=data
DB_FILE=metrazh.db

# Сессии и cookies
NODE_ENV=development
TRUST_PROXY=0
COOKIE_SECURE=0
SESSION_TTL_DAYS=7

# Первый администратор. Используется только при создании пустой базы.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-please

# Демо-режим: подсказка с логином/паролем на странице входа.
DEMO_MODE=1

# Заполнять ли пустую базу демонстрационными объектами и справочниками.
SEED_DEMO=1

# Ограничение попыток входа
LOGIN_RATE_LIMIT=12
LOGIN_RATE_WINDOW_MINUTES=15

# Название приложения
APP_NAME=Метраж
